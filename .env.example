# ————————————————————————————————————————————————————————————
# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
# NOTHING in this file may ever be prefixed VITE_ except where noted:
# Vite inlines VITE_* into the browser bundle, so those values are public.
# ————————————————————————————————————————————————————————————

# ————— Database —————
# Atlas → Connect → Drivers. Use a database user scoped to this one DB,
# not an Atlas admin. URL-encode any special characters in the password.
MONGODB_URI="mongodb+srv://ryzn_app:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Use ryzn_dev for local + preview so branch deploys never touch real user data.
MONGODB_DB="ryzn"

# ————— Better Auth —————
# Signs session cookies. Generate with: openssl rand -base64 32
# A different value per environment. Changing it invalidates all sessions.
BETTER_AUTH_SECRET=""
# Must exactly match the origin the BROWSER is on, not where the function runs.
# In local dev you browse Vite on :5173 and it proxies /api to `vercel dev` on
# :3000 — so this is 5173, and that's the origin Google must redirect back to.
#   local       http://localhost:5173
#   production  https://ryzn.one
BETTER_AUTH_URL="http://localhost:5173"

# ————— Google OAuth —————
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Add one entry per environment (localhost AND production).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ————— Email (password reset codes) —————
# Optional locally: with no key, reset codes print to the function logs so you
# can still test the whole flow. Required in production.
RESEND_API_KEY=""
EMAIL_FROM="Ryzn <noreply@ryzn.one>"

# ————— Turnstile (bot protection on sign-up) —————
# dash.cloudflare.com → Turnstile → add a site, widget mode "Managed".
# Both must be set together, or not at all — set only one and sign-up breaks
# (server demands a captcha header the client never sends, or vice versa).
# Secret is server-only. Site key is meant to be public: prefixing it VITE_
# is correct here, unlike everything else in this file.
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""
