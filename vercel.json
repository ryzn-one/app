{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/program.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth-handler" },
    { "source": "/p/:code", "destination": "/api/posts?share=:code" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    {
      "source": "/:handle((?!api|app|p|branding|assets|admin)[^/]+)/:slug([^/]+)",
      "destination": "/api/posts?share=:slug&handle=:handle"
    }
  ],
  "redirects": [
    { "source": "/invite.html", "destination": "/mentor-invite.html", "permanent": true }
  ]
}
